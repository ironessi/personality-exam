# ──────────────────────────────────────────────────────────────
# rag-service 环境变量样例
#
# 用法：cp .env.example .env  然后把 LLM_API_KEY 填上
# ⚠️ .env 已被 .gitignore 忽略，绝不能提交
# ──────────────────────────────────────────────────────────────

# ── 服务 ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
# 留空 = 不校验调用方身份（仅限 127.0.0.1 内网）。暴露端口时必须填。
SERVICE_API_KEY=

# ── 本地向量模型（BAAI/bge-small-zh-v1.5，512 维）─────────────
# 已在开发机实测存在的 HF 快照目录
EMBEDDING_MODEL_PATH=/Users/iron/.cache/huggingface/hub/models--BAAI--bge-small-zh-v1.5/snapshots/7999e1d3359715c523056ef9478215996d62a620
# 断言用：模型实际维度必须是这个值，不符则启动失败
EMBEDDING_DIM=512

# ── Chroma 向量库 ─────────────────────────────────────────────
CHROMA_PATH=data/chroma
COLLECTION_NAME=psychology_knowledge

# ── DeepSeek ──────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
# ⚠️ 必填。没有它 /health 的 llm_reachable 会是 false
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
# 关闭思考。DeepSeek V4 默认带 reasoning，会把 2048 预算吃光导致 content 为空
# （实测 finish_reason=length、content=""、reasoning_tokens=2048）。
# 取值 disabled / auto。除非确实需要推理，否则保持 disabled。
LLM_THINKING=disabled

# ── 检索 ──────────────────────────────────────────────────────
# 知识库分区键 = 构念域（ADR-0008），必须与 data/raw/ 下的目录名一致。
# 不是测评名：按测评建 namespace 会得到 42 个几乎同质的索引。
KB_NAMESPACES=["symptom","trait","typology","social","wellbeing","career","ability","common"]
TOP_K=5
BM25_TOP_K=5

# ── 启动预热 ──────────────────────────────────────────────────
# 必须保持 true：首次 encode 有 3~4s 预热开销，
# 不预热则冷启动后第一个请求必然撑爆 ADR-0007 的 3 秒同步期限。
WARMUP_ON_STARTUP=true

# ── 引用验证 Stage 2（NLI 语义蕴含，ADR-0003） ────────────────
# 本地目录优先（相对路径按 rag-service/ 解析）；留空则按 NLI_MODEL_NAME 联网下载。
# 权重约 390MB，镜像构建期拉取，不进版本库（见 .gitignore 的 .models/）。
# ⚠️ 权重缺失不会让服务挂掉，但 Stage 2 会静默退化成「只验字面」——
#    启动日志会有一条 WARNING，生产上线前必须确认它是绿色的。
NLI_MODEL_PATH=.models/Erlangshen
NLI_MODEL_NAME=IDEA-CCNL/Erlangshen-Roberta-110M-NLI
