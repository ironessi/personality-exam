.env

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# ── 数据 ─────────────────────────────────────────────
# 向量库可随时用 scripts/ingest_cli.py 重建，不入库（主文档 §4 :205）
data/chroma/
# 切块产物同理：由 data/raw/ 确定性生成
data/processed/

# 注意：data/raw/ 是知识库的**唯一真源**，必须入库。

# ── 第三方模型权重 ────────────────────────────────────
# NLI 语义蕴含模型（ADR-0003 Stage 2）约 390MB，本地开发放这里；
# 生产镜像在 build 期拉取，不进版本库。
.models/
# 若临时让 HF 把权重下到工作区（HF_HOME），同样不入库
.cache/
